<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>GameDock.App</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GameDock</AssemblyName>
    <Version>0.1.0</Version>
    <Description>GameDock 图形界面：下载 Minecraft 版本/加载器并一键导入 PCL2 / HMCL / FCL。</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameDock.Core\GameDock.Core.csproj" />
  </ItemGroup>

</Project>
